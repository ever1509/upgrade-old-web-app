<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <connectionStrings>
    <!-- Must match the web app's connection string. See Web.config. -->
    <add name="ExpenseFlow"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ExpenseFlow;Integrated Security=True;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="ExpenseFlow:QueuePath" value=".\private$\expenseflow" />
    <add key="ExpenseFlow:DeadLetterPath" value=".\private$\expenseflow_dead" />

    <!-- Must match ExpenseFlow:UploadPath in the web app's Web.config.
         Two processes agreeing on a filesystem path by convention: fragile,
         and impossible once the two halves live on different machines. -->
    <add key="ExpenseFlow:UploadRoot" value="C:\ExpenseFlow\uploads" />

    <!-- Where generated claim PDFs are written. -->
    <add key="ExpenseFlow:PdfRoot" value="C:\ExpenseFlow\pdf" />

    <!-- The web app's base URL, for the SignalR notify callback. -->
    <add key="ExpenseFlow:WebBaseUrl" value="http://localhost:52080/" />
    <add key="ExpenseFlow:InternalApiKey" value="local-dev-worker-key" />

    <add key="ExpenseFlow:FromAddress" value="expenseflow@localhost" />
  </appSettings>

  <system.net>
    <mailSettings>
      <!-- No SMTP server needed locally: every email is written to disk as a
           .eml file you can open in Outlook or a text editor. -->
      <smtp deliveryMethod="SpecifiedPickupDirectory" from="expenseflow@localhost">
        <specifiedPickupDirectory pickupDirectoryLocation="C:\ExpenseFlow\mail" />
      </smtp>
    </mailSettings>
  </system.net>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <log4net>
    <appender name="Console" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date{HH:mm:ss} %-5level %message%newline%exception" />
      </layout>
    </appender>
    <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
      <file value="logs\worker.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="5MB" />
      <staticLogFileName value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="Console" />
      <appender-ref ref="RollingFile" />
    </root>
  </log4net>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
