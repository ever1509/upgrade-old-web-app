<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Phase 4, steps 1-3, applied to the one project that was always going to be
    free: SDK-style, and multi-targeted.

    Domain has no System.Web, no EF, no Windows APIs - just entities and rules -
    so it compiles for .NET 10 with no changes at all. That is the payoff for
    having kept it pure, and it is the contrast that explains why everything
    else in this solution is expensive.

    net48   - consumed by the existing Web and Worker projects
    net10.0 - the destination, and what lets this build in Rider on macOS
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>ExpenseFlow.Domain</RootNamespace>
    <AssemblyName>ExpenseFlow.Domain</AssemblyName>
    <!-- Pinned so nothing accidentally uses syntax the net48 leg cannot compile. -->
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Keep the hand-written Properties/AssemblyInfo.cs instead of generating one. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
  </ItemGroup>

</Project>
