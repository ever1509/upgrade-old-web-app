<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Multi-targeted, with the MSMQ implementation compiled only for net48.

    System.Messaging does not exist outside .NET Framework, so rather than
    delete the MSMQ classes - they are the "before" half of the migration
    story and worth keeping - they are simply excluded from the net10.0
    compilation. MessagingFactory guards its MSMQ arms with #if NET48.

    Result: the file transport, the contracts and both interfaces are fully
    portable, so a .NET 10 worker can consume the same queue the .NET
    Framework web app publishes to. That is what makes slice 1 possible.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>ExpenseFlow.Messaging</RootNamespace>
    <AssemblyName>ExpenseFlow.Messaging</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- MSMQ is .NET Framework only, in both directions: the API and the OS. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Messaging" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="MsmqMessagePublisher.cs" />
    <Compile Remove="MsmqMessageReceiver.cs" />
    <Compile Remove="MsmqNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseFlow.Domain\ExpenseFlow.Domain.csproj" />
  </ItemGroup>

</Project>
