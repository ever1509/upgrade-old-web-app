<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Also multi-targeted, which is less obvious than Domain but turns out to
    work: EF6 ships a netstandard2.1 build, so the DbContext, the mappings and
    the repositories all compile for .NET 10 unchanged.

    That does NOT mean the data layer is migrated. It means it compiles. EF6 on
    .NET 10 is a transitional state, not a destination - the real work is
    EF6 -> EF Core, which is ledger item B5 and the highest-risk item in the
    whole migration because it fails silently rather than at build time.

    What this buys today: the tests can exercise this code on .NET 10, on macOS.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <RootNamespace>ExpenseFlow.Data</RootNamespace>
    <AssemblyName>ExpenseFlow.Data</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EntityFramework" Version="6.4.4" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- On .NET Framework, SqlParameter comes from System.Data.dll.
         Everywhere else it needs an explicit package. -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExpenseFlow.Domain\ExpenseFlow.Domain.csproj" />
  </ItemGroup>

</Project>
