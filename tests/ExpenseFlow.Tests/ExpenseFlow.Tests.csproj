<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style csproj deliberately targeting .NET Framework 4.8.

    Two reasons: it keeps the legacy app untouched while giving the tests a
    modern project format, and it is a rehearsal for phase 4, when every
    project makes this same conversion. At that point this single line

        <TargetFramework>net48</TargetFramework>

    becomes

        <TargetFrameworks>net48;net10.0</TargetFrameworks>

    and the rule tests below start running on BOTH stacks - which is what
    lets you prove the migrated app behaves identically to the old one.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>ExpenseFlow.Tests</AssemblyName>
    <RootNamespace>ExpenseFlow.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The Data project resolves EF6 through a packages.config HintPath;
         referencing it here too guarantees it lands in the test output. -->
    <PackageReference Include="EntityFramework" Version="6.4.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExpenseFlow.Domain\ExpenseFlow.Domain.csproj" />
    <ProjectReference Include="..\..\src\ExpenseFlow.Data\ExpenseFlow.Data.csproj" />
  </ItemGroup>

</Project>
