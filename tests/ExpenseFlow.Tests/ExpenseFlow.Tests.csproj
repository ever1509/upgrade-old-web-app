<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Now multi-targeted, which is the whole point of the exercise.

    The same 72 assertions run against .NET Framework 4.8 AND .NET 10. When a
    migration step changes behaviour, one leg goes red and the other stays
    green, and the difference is the bug. Without this you are comparing a
    memory of how the old app behaved against how the new one behaves.

        dotnet test -f net10.0    works on macOS
        dotnet test -f net48      Windows only

    Running with no -f runs both, which is what CI should do.
  -->

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ExpenseFlow.Tests</AssemblyName>
    <RootNamespace>ExpenseFlow.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ExpenseFlow.Domain\ExpenseFlow.Domain.csproj" />
    <ProjectReference Include="..\..\src\ExpenseFlow.Data\ExpenseFlow.Data.csproj" />
  </ItemGroup>

</Project>
